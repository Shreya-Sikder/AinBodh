   LEGAL ASK API
========================================================= */

app.post(
  "/api/legal/ask",
  async (req, res) => {
    try {
      const question =
        typeof req.body?.question ===
        "string"
          ? req.body.question.trim()
          : "";

      const requestedLanguage =
        normalizeRequestedLanguage(
          req.body?.language,
        );

      const history: ChatHistoryMessage[] =
        Array.isArray(
          req.body?.history,
        )
          ? req.body.history.filter(
              (
                message: unknown,
              ): message is ChatHistoryMessage =>
                typeof message ===
                  "object" &&
                message !== null &&
                "role" in message &&
                "content" in message &&
                (
                  (
                    message as {
                      role?: unknown;
                    }
                  ).role === "user" ||
                  (
                    message as {
                      role?: unknown;
                    }
                  ).role ===
                    "assistant"
                ) &&
                typeof (
                  message as {
                    content?: unknown;
                  }
                ).content ===
                  "string",
            )
          : [];

      const contextualQuestion =
        buildConversationContext(
          history,
          question,
        );

      console.log(
        "Requested language:",
        requestedLanguage ||
          "auto",
      );

      console.log(
        "Conversation history messages:",
        history.length,
      );

      if (!question) {
        return res.status(400).json({
          ok: false,
          error:
            "Question is required.",
        });
      }

      console.log("");
      console.log(
        "========================================",
      );
      console.log(
        "LEGAL QUESTION",
      );
      console.log(
        "========================================",
      );

      console.log(
        "Question:",
        question,
      );

      /* =====================================================
         STEP 1 — INTENT
      ===================================================== */

      const intent =
        detectLegalIntent(
          contextualQuestion,
        );

      console.log(
        "Intent:",
        intent,
      );

      /* =====================================================
         STEP 2 — SITUATION
      ===================================================== */

      const situation =
        await analyzeSituation(
          contextualQuestion,
          intent,
        );

      console.log(
        "Query type:",
        situation.queryType,
      );

      console.log(
        "Legal issue:",
        situation.legalIssue,
      );

      console.log(
        "Retrieval query:",
        situation.retrievalQuery,
      );

      console.log(
        "Missing facts:",
        situation.missingFacts,
      );

      /* =====================================================
         STEP 3 — SEARCH TERMS
      ===================================================== */

      const searchTerms =
        extractLegalSearchTerms(
          contextualQuestion,
          intent,
          situation.retrievalQuery,
        );

      console.log(
        "Search terms:",
        searchTerms,
      );

      /* =====================================================
         STEP 4 — RETRIEVAL
      ===================================================== */

      const lexicalResults =
        await lexicalSearch(
          searchTerms,
        );

      let semanticResults:
        LegalResult[] = [];

      try {
        semanticResults =
          await semanticSearch(
            situation.retrievalQuery ||
              contextualQuestion,
          );
      } catch (error) {
        console.error(
          "Optional semantic retrieval failed:",
          error,
        );
      }

      console.log(
        "Lexical results:",
        lexicalResults.length,
      );

      console.log(
        "Semantic results:",
        semanticResults.length,
      );

      /* =====================================================
         STEP 5 — MERGE
      ===================================================== */

      const rankedResults =
        mergeResults(
          contextualQuestion,
          intent,
          lexicalResults,
          semanticResults,
          searchTerms,
        );

      console.log(
        "Ranked results:",
        rankedResults.length,
      );

      /* =====================================================
         STEP 6 — EVIDENCE
      ===================================================== */

      const evidence =
        buildEvidence(
          rankedResults,
          intent,
        );

      console.log(
        "Evidence:",
        evidence.map(
          (item) =>
            `${item.id}: ${item.title} Section ${item.sectionNumber}`,
        ),
      );

      /* =====================================================
         STEP 7 — NO EVIDENCE
      ===================================================== */

      if (
        evidence.length === 0
      ) {
        const answer =
          requestedLanguage ===
          "bn"
            ? "এই প্রশ্নের জন্য উপলভ্য বাংলাদেশি আইনগত প্রমাণ থেকে যথেষ্ট প্রাসঙ্গিক বিধান পাওয়া যায়নি।"
            : "I could not retrieve a sufficiently relevant provision from the available Bangladesh-law evidence for this question.";

        console.log(
          "No sufficient legal evidence found.",
        );

        return res.json({
          ok: true,
          grounded: false,
          answer,
          citations: [],
          intent,
          situation,
        });
      }

      /* =====================================================
         STEP 8 — GROUNDED ANSWER
      ===================================================== */

      const answer =
        await generateAnswer(
          question,
          evidence,
          situation,
          requestedLanguage,
          history,
        );

      /*
       * -----------------------------------------------------
       * APPLICABILITY STATUS
       * -----------------------------------------------------
       *
       * An answer may have citations and still not be fully
       * grounded to the user's specific situation if important
       * applicability facts remain unknown.
       *
       * This is especially important for inheritance/property
       * disputes.
       */

      const normalizedApplicabilityText =
        normalizeLegalText(
          `${question} ${situation.legalIssue}`,
        );

      const inheritanceTerms = [
        "inheritance",
        "inherit",
        "heir",
        "heirs",
        "will",
        "testator",
        "estate",
        "succession",
        "grandfather",
        "grandmother",
        "uncle",
        "uncles",
        "cousin",
        "father's assets",
        "father assets",
        "property share",
        "family property",
      ];

      const inheritanceSituation =
        inheritanceTerms.some((term) =>
          normalizedApplicabilityText.includes(
            term,
          ),
        );

      const applicabilityNeedsClarification =
        inheritanceSituation &&
        situation.missingFacts.length > 0;

      console.log(
        "Inheritance/family-property situation:",
        inheritanceSituation,
      );

      console.log(
        "Applicability needs clarification:",
        applicabilityNeedsClarification,
      );

      console.log(
        "========================================",
      );

      return res.json({
        ok: true,

        /*
         * false means the response contains evidence-backed
         * information but applicability to the exact situation
         * has not been fully established.
         */
        grounded:
          !applicabilityNeedsClarification,

        applicabilityConfirmed:
          !applicabilityNeedsClarification,

        answer,

        citations:
          evidence.map(
            (item) => ({
              id: item.id,
              title: item.title,
              section:
                item.sectionNumber,
              sourceName:
                item.sourceName,
              sourceUrl:
                item.sourceUrl,
            }),
          ),

        intent,
        situation,
      });
    } catch (error) {
      console.error(
        "LEGAL ASK ERROR:",
        error,
      );

      const message =
        error instanceof Error
          ? error.message
          : "Legal answer generation failed.";

      return res.status(500).json({
        ok: false,
        error: message,
      });
    }
  },
);
function dedupeStrings(items: string[]): string[] {
  const seen = new Set<string>();

  return items.filter((item) => {
    const key = normalizeLegalText(item);

    if (!key || seen.has(key)) {
      return false;
    }

    seen.add(key);
    return true;
  });
}

