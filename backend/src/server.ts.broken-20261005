type SourceInfo = {
  sourceName: string;
  sourceUrl: string;
};

function getOfficialSource(
  actFile: string,
  sectionNumber: string | null,
): SourceInfo | null {
  if (
    actFile !== "748.json"
  ) {
    return null;
  }

  const actUrl =
    "https://bdlaws.minlaw.gov.bd/act-print-748.html";

  if (
    sectionNumber === "19"
  ) {
    return {
      sourceName:
        "Laws of Bangladesh — বাড়ী ভাড়া নিয়ন্ত্রণ আইন, ১৯৯১, ধারা ১৯",
      sourceUrl:
        "https://bdlaws.minlaw.gov.bd/act-print-748/section-print-30649.html",
    };
  }

  if (
    sectionNumber === "13"
  ) {
    return {
      sourceName:
        "Laws of Bangladesh — বাড়ী ভাড়া নিয়ন্ত্রণ আইন, ১৯৯১, ধারা ১৩",
      sourceUrl:
        "https://bdlaws.minlaw.gov.bd/act-print-748/section-print-30643.html",
    };
  }

  return {
    sourceName:
      "Laws of Bangladesh — বাড়ী ভাড়া নিয়ন্ত্রণ আইন, ১৯৯১",
    sourceUrl: actUrl,
  };
}

/* =========================================================
   EVIDENCE
========================================================= */

type EvidenceItem = {
  id: string;
  title: string;
  actFile: string;
  sectionNumber: string | null;
  text: string;
  sourceName?: string;
  sourceUrl?: string;
};

function buildEvidence(
  results: LegalResult[],
  intent: LegalIntent,
): EvidenceItem[] {
  const output: EvidenceItem[] = [];

  if (
    intent === "rent_refusal"
  ) {
    for (
      const result of results
    ) {
      if (
        !isHouseRentAct(result)
      ) {
        continue;
      }

      const section =
        chooseBestSection(
          result,
          intent,
        );

      if (!section) {
        continue;
      }

      if (
        section.sectionNumber !==
        "19"
      ) {
        continue;
      }

      const source =
        getOfficialSource(
          result.act_file,
          "19",
        );

      output.push({
        id: "C1",
        title: result.title,
        actFile: result.act_file,
        sectionNumber: "19",
        text: section.text,
        sourceName:
          source?.sourceName,
        sourceUrl:
          source?.sourceUrl,
      });

      break;
    }

    return output;
  }

  if (
    intent === "rent_receipt"
  ) {
    for (
      const result of results
    ) {
      if (
        !isHouseRentAct(result)
      ) {
        continue;
      }

      const section =
        chooseBestSection(
          result,
          intent,
        );

      if (!section) {
        continue;
      }

      if (
        section.sectionNumber !==
        "13"
      ) {
        continue;
      }

      const source =
        getOfficialSource(
          result.act_file,
          "13",
        );

      output.push({
        id: "C1",
        title: result.title,
        actFile: result.act_file,
        sectionNumber: "13",
        text: section.text,
        sourceName:
          source?.sourceName,
        sourceUrl:
          source?.sourceUrl,
      });

      break;
    }

    return output;
  }

  const filteredResults =
    results.filter(
      (result) => {
        const similarity =
          Number(
            result.similarity ??
              0,
          );

        const combinedScore =
          Number(
            result.combinedScore ??
              0,
          );

        const matchedTerms =
          Array.isArray(
            result.matchedTerms,
          )
            ? result.matchedTerms
                .length
            : 0;

        const strongSemantic =
          similarity >= 0.42;

        const strongCombined =
          combinedScore >= 0.25 &&
          matchedTerms >= 2;

        return (
          strongSemantic ||
          strongCombined
        );
      },
    );

  console.log(
    "Evidence candidate gate:",
    results.length,
    "retrieved ->",
    filteredResults.length,
    "eligible",
  );

  for (
    const result of filteredResults
  ) {
    const section =
      chooseBestSection(
        result,
        intent,
      );

    if (!section) {
      continue;
    }

    const duplicate =
      output.some(
        (item) =>
          item.actFile ===
            result.act_file &&
          item.sectionNumber ===
            section.sectionNumber,
      );

    if (duplicate) {
      continue;
    }

    const source =
      getOfficialSource(
        result.act_file,
        section.sectionNumber,
      );

    output.push({
      id: `C${output.length + 1}`,
      title: result.title,
      actFile: result.act_file,
      sectionNumber:
        section.sectionNumber,
      text: section.text,
      sourceName:
        source?.sourceName,
      sourceUrl:
        source?.sourceUrl,
    });

    if (
      output.length >= 4
    ) {
      break;
    }
  }

  return output;
}

