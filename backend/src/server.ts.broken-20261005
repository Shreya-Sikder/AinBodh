    text.includes("tenant") ||
    text.includes("ভাড়াটিয়া") ||
    text.includes("ভাড়াটিয়া");

  const rentRefusalTerms = [
    "ভাড়া গ্রহণ করতে অস্বীকার",
    "গ্রহণ করতে অস্বীকার",
    "ভাড়া গ্রহণ করতে চাইছে না",
    "ভাড়া গ্রহণ করতে চাচ্ছে না",
    "ভাড়া নিতে অস্বীকার",
    "ভাড়া নিতে অস্বীকার করছে",
    "ভাড়া নিতে চাইছে না",
    "ভাড়া নিতে চাচ্ছে না",
    "ভাড়া নিচ্ছে না",
    "ভাড়া নিচ্ছেন না",
    "ভাড়া নেয় না",
    "ভাড়া নেয় না",
    "ভাড়া গ্রহণ করতে অস্বীকার",
    "ভাড়া গ্রহণ করতে চাইছে না",
    "ভাড়া গ্রহণ করতে চাচ্ছে না",
    "ভাড়া নিতে অস্বীকার",
    "ভাড়া নিতে অস্বীকার করছে",
    "ভাড়া নিতে চাইছে না",
    "ভাড়া নিতে চাচ্ছে না",
    "ভাড়া নিচ্ছে না",
    "ভাড়া নিচ্ছেন না",
    "ভাড়া নেয় না",
    "rent refused",
    "refused to accept rent",
    "refuses to accept rent",
    "won't accept rent",
    "will not accept rent",
    "not accepting rent",
  ];

  const receiptTerms = [
    "ভাড়ার রশিদ",
    "ভাড়ার রশিদ",
    "রশিদ প্রদান",
    "ভাড়া পরিশোধের রশিদ",
    "ভাড়া পরিশোধের রশিদ",
    "ভাড়ার receipt",
    "rent receipt",
    "receipt for rent",
  ];

  const evictionTerms = [
    "উচ্ছেদ",
    "উচ্ছেদের নোটিশ",
    "উচ্ছেদ নোটিশ",
    "বাড়ি থেকে বের করে",
    "বাড়ি থেকে বের করে",
    "বের করে দিতে",
    "বের করে দেব",
    "eviction",
    "eviction notice",
    "evict",
  ];

  if (
    hasRent &&
    rentRefusalTerms.some((term) =>
      text.includes(term),
    ) &&
    (hasLandlordTenant ||
      rentRefusalTerms.some((term) =>
        text.includes(term),
      ))
  ) {
    return "rent_refusal";
  }

  if (
    hasRent &&
    receiptTerms.some((term) =>
      text.includes(term),
    ) &&
    (hasLandlordTenant ||
      receiptTerms.some((term) =>
        text.includes(term),
      ))
  ) {
    return "rent_receipt";
  }

  if (
    evictionTerms.some((term) =>
      text.includes(term),
    ) &&
    (hasLandlordTenant || hasRent)
  ) {
    return "eviction";
  }

  const landlordRefusingRent =
    hasRent &&
    hasLandlordTenant &&
    (
      text.includes("নিতে চাচ্ছে না") ||
      text.includes("নিতে চাইছে না") ||
      text.includes("নিচ্ছে না") ||
      text.includes("নিচ্ছেন না") ||
