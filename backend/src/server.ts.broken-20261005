function isHouseRentAct(
  result: LegalResult,
): boolean {
  const title = normalizeBangla(
    result.title || "",
  );

  return (
    result.act_file === "748.json" ||
    title.includes(
      "বাড়ি ভাড়া নিয়ন্ত্রণ আইন",
    ) ||
    title.includes(
      "বাড়ি ভাড়া নিয়ন্ত্রণ আইন",
    )
  );
}

/* =========================================================
   EXACT SCORE
========================================================= */

function calculateExactScore(
  result: LegalResult,
  intent: LegalIntent,
): number {
  const text = normalizeBangla(
    result.text || "",
  );

  if (intent === "rent_refusal") {
    let score = 0;

    if (
      text.includes(
        "গ্রহণ করতে অস্বীকার",
      )
    ) {
      score += 1;
    }

    if (
      text.includes(
        "ডাক মনি অর্ডার",
      )
    ) {
      score += 1;
    }

    if (
      text.includes(
        "ভাড়া জমা",
      )
    ) {
      score += 1;
    }

    if (
      text.includes(
        "বাড়িওয়ালা",
      )
    ) {
      score += 0.5;
    }

    if (
      text.includes(
        "ভাড়াটিয়া",
      )
    ) {
      score += 0.5;
    }

    return Math.min(score / 3, 1);
  }

  if (intent === "rent_receipt") {
    let score = 0;

    if (text.includes("রশিদ")) {
      score += 1;
    }

    if (text.includes("ভাড়া")) {
      score += 1;
    }

    if (
      text.includes("ভাড়াটিয়া")
    ) {
      score += 0.5;
    }

    if (
      text.includes("বাড়িওয়ালা")
    ) {
      score += 0.5;
    }

    return Math.min(score / 2.5, 1);
  }

  return 0;
}

/* =========================================================
   RANK
========================================================= */

function mergeResults(
  _question: string,
  intent: LegalIntent,
  lexical: LegalResult[],
  semantic: LegalResult[],
  terms: string[],
): LegalResult[] {
  const map = new Map<
    string,
    LegalResult
  >();

  function add(
    result: LegalResult,
    source:
      | "lexical"
      | "semantic",
  ) {
    const key =
      result.id ||
      `${result.act_file}:${result.start}:${result.end}`;

    const old = map.get(key);

    const lexicalScore =
      source === "lexical"
        ? Math.max(
            Number(result.rank || 0),
            Number(
              old?.lexicalScore || 0,
            ),
          )
        : Number(
            old?.lexicalScore || 0,
          );

    const similarity =
      source === "semantic"
        ? Math.max(
            Number(
              result.similarity || 0,
            ),
            Number(
              old?.similarity || 0,
            ),
          )
        : Number(
            old?.similarity || 0,
          );

    const actBoost =
      intent === "rent_refusal" ||
      intent === "rent_receipt"
        ? isHouseRentAct(result)
          ? 1
          : 0
        : 0;

    const exactScore =
      calculateExactScore(
        result,
        intent,
      );

    const normalizedResultText =
      normalizeBangla(
        result.text || "",
      );

    const matchedTerms =
      Array.from(
        new Set([
          ...(old?.matchedTerms || []),
          ...terms.filter((term) =>
            normalizedResultText.includes(
              normalizeBangla(term),
            ),
          ),
        ]),
      );

    const combinedScore =
      exactScore * 0.35 +
      (Math.min(lexicalScore, 1.5) / 1.5) *
        0.25 +
      actBoost * 0.10 +
      Math.min(similarity, 1) * 0.30;

    map.set(key, {
      ...(old || result),
      lexicalScore,
      similarity,
      exactScore,
      actBoost,
      combinedScore,
      matchedTerms,
    });
  }

  for (const item of lexical) {
    add(item, "lexical");
  }

  for (const item of semantic) {
    add(item, "semantic");
  }

  let ranked =
    Array.from(map.values());

  if (
    intent === "rent_refusal" ||
    intent === "rent_receipt"
  ) {
    ranked = ranked.filter(
      (item) =>
        isHouseRentAct(item),
    );
  }

  return ranked
    .sort(
      (a, b) =>
        Number(
          b.combinedScore || 0,
        ) -
        Number(
          a.combinedScore || 0,
        ),
    )
    .slice(0, 10);
}

/* =========================================================
   SECTION EXTRACTION
========================================================= */

const BANGLA_DIGITS =
  "০১২৩৪৫৬৭৮৯";

function banglaDigitsToArabic(
  value: string,
): string {
  return value
    .split("")
    .map((char) => {
      const index =
        BANGLA_DIGITS.indexOf(char);

      return index >= 0
        ? String(index)
        : char;
    })
    .join("");
}

type SectionEvidence = {
  sectionNumber: string;
  text: string;
};

function extractSections(
  text: string,
): SectionEvidence[] {
  if (!text) {
    return [];
  }

  const regex =
    /([০-৯]{1,3}|[0-9]{1,3})\s*[।.]/g;

  const matches: {
    number: string;
    index: number;
  }[] = [];

  let match: RegExpExecArray | null;

  while (
    (match = regex.exec(text)) !== null
  ) {
    const raw = match[1];

    const number =
      /[০-৯]/.test(raw)
        ? banglaDigitsToArabic(raw)
        : raw;

    const n = Number(number);

    if (
      Number.isInteger(n) &&
      n >= 1 &&
      n <= 999
    ) {
      matches.push({
        number,
        index: match.index,
      });
    }
  }

  const sections: SectionEvidence[] =
    [];

  for (
    let i = 0;
    i < matches.length;
    i++
  ) {
    const current = matches[i];
    const next = matches[i + 1];

    const start = current.index;

    const end = next
      ? next.index
      : text.length;

    const sectionText = text
      .slice(start, end)
      .trim()
      .slice(0, 6500);

    sections.push({
      sectionNumber:
        current.number,
      text: sectionText,
    });
  }

  return sections;
}

/* =========================================================
   CHOOSE SECTION
========================================================= */

function chooseBestSection(
  result: LegalResult,
  intent: LegalIntent,
): SectionEvidence | null {
  const sections =
    extractSections(
      result.text || "",
    );

  if (sections.length === 0) {
    return null;
  }

  if (
    intent === "rent_refusal" &&
    isHouseRentAct(result)
  ) {
    const section19 =
      sections.find(
        (section) =>
          section.sectionNumber === "19",
      );

    if (section19) {
      return section19;
    }
  }

  if (
    intent === "rent_receipt" &&
    isHouseRentAct(result)
  ) {
    const section13 =
      sections.find(
        (section) =>
          section.sectionNumber === "13",
      );

    if (section13) {
      return section13;
    }
  }

  const canonicalTerms =
    INTENT_TERMS[intent].map(
      normalizeBangla,
    );

  let best:
    | SectionEvidence
    | null = null;

  let bestScore = -1;

  for (const section of sections) {
    const t =
      normalizeBangla(
        section.text,
      );

    let score = 0;

    for (const term of canonicalTerms) {
      if (t.includes(term)) {
        score++;
      }
    }

    if (score > bestScore) {
      bestScore = score;
      best = section;
    }
  }

  return best;
}

/* =========================================================
   EXPLICIT DOCUMENT LEGAL REFERENCES
========================================================= */

type ExplicitLegalReference = {
  actName: string;
  sections: string[];
};

function extractSectionNumbers(
  value: string,
): string[] {
  return Array.from(
    value.matchAll(
      /\d+[A-Za-z]?(?:\(\d+[A-Za-z]?\))?/g,
    ),
  ).map((match) => match[0]);
}

function cleanExplicitActName(
  value: string,
): string {
  return value
    .replace(/\s+/g, " ")
    .replace(/^[\s,.;:()-]+/, "")
    .replace(/[\s,.;:()-]+$/, "")
    .trim();
}

function extractExplicitLegalReferences(
  text: string,
): ExplicitLegalReference[] {
  const references: ExplicitLegalReference[] = [];

  const normalized = text
    .replace(/[“”]/g, '"')
    .replace(/[‘’]/g, "'")
    .replace(/[–—]/g, "-")
    .replace(/\s+/g, " ")
    .trim();

  const sectionActRegex =
    /\bsections?\s+(.{1,120}?)\s+of\s+(?:the\s+)?([A-Za-z][A-Za-z0-9&.'()\- ]*?\bAct\b(?:\s*,?\s*\d{4})?)/gi;

  let match: RegExpExecArray | null;

  while (
    (match =
      sectionActRegex.exec(
        normalized,
      )) !== null
  ) {
    const rawSections = match[1];
    const rawAct = match[2];

    const sections =
      extractSectionNumbers(
        rawSections,
      );

    const actName =
      cleanExplicitActName(
        rawAct,
      );

    if (
      actName &&
      sections.length > 0
    ) {
      references.push({
        actName,
        sections: [
          ...new Set(sections),
        ],
      });
    }
  }

  const standaloneActRegex =
    /\b((?:[A-Z][A-Za-z0-9&.'()\-]*|of|the|and|for|on|in|to)\s+){1,10}Act\b(?:\s*,?\s*\d{4})?/g;

  while (
    (match =
      standaloneActRegex.exec(
        normalized,
      )) !== null
  ) {
    const actName =
      cleanExplicitActName(
        match[0],
      );

    if (
      actName.length < 8
    ) {
      continue;
    }

    if (
      !/\bAct\b(?:\s*,?\s*\d{4})?$/i.test(
        actName,
      )
    ) {
      continue;
    }

    const normalizedAct =
      normalizeActName(
        actName,
      );

    const existing =
      references.find(
        (reference) =>
          normalizeActName(
            reference.actName,
          ) === normalizedAct,
      );

    if (!existing) {
      references.push({
        actName,
        sections: [],
      });
    }
  }

  const deduped = new Map<
    string,
    ExplicitLegalReference
  >();

  for (
    const reference of references
  ) {
    const key =
      normalizeActName(
        reference.actName,
      );

    if (!key) {
      continue;
    }

    const previous =
      deduped.get(key);

    if (!previous) {
      deduped.set(key, {
        actName:
          reference.actName,
        sections: [
          ...new Set(
            reference.sections,
          ),
        ],
      });
    } else {
      previous.sections = [
        ...new Set([
          ...previous.sections,
          ...reference.sections,
        ]),
      ];
    }
  }

  return Array.from(
    deduped.values(),
  );
}

/* =========================================================
   DOCUMENT LEGAL REFERENCE SCORING
========================================================= */

function scoreDocumentLegalReference(
  result: LegalResult,
  reference: ExplicitLegalReference,
): number {
  const title =
    normalizeActName(
      result.title || "",
    );

  const actFile =
    normalizeActName(
      result.act_file || "",
    );

  const resultText =
    normalizeLegalText(
      result.text || "",
    );

  const resultSection =
    normalizeLegalText(
      result.sectionNumber || "",
    );

  const actName =
    normalizeActName(
      reference.actName,
    );

  if (!actName) {
    return 0;
  }

  const titleExact =
    title === actName;

  const titleContains =
    title.includes(actName);

  const actNameContainsTitle =
    title.length > 0 &&
    actName.includes(title);

  const actFileLooksLikeActName =
    actFile.length > 8 &&
    /[a-z]/i.test(actFile);

  const actFileMatches =
    actFileLooksLikeActName &&
    (
      actFile === actName ||
      actFile.includes(actName) ||
      actName.includes(actFile)
    );

  const textContainsAct =
    resultText.includes(
      actName,
    );

  const actMatches =
    titleExact ||
    titleContains ||
    actNameContainsTitle ||
    actFileMatches ||
    textContainsAct;

  if (!actMatches) {
    return 0;
  }

  let score = 100;

  if (titleExact) {
    score += 150;
  } else if (
    titleContains ||
    actNameContainsTitle
  ) {
    score += 120;
  } else if (
    actFileMatches
  ) {
    score += 80;
  } else if (
    textContainsAct
  ) {
    score += 60;
  }

  let sectionMatched = false;

  for (
    const requestedSection of
      reference.sections
  ) {
    const normalizedSection =
      normalizeLegalText(
        requestedSection,
      );

    if (
      resultSection ===
      normalizedSection
    ) {
      score += 200;
      sectionMatched = true;
      continue;
    }

    const escapedSection =
      requestedSection.replace(
        /[.*+?^${}()|[\]\\]/g,
        "\\$&",
      );

    const exactSectionPattern =
      new RegExp(
        `\\bsections?\\s+${escapedSection}(?=\\s|[.,;:)\\]])`,
        "i",
      );

    if (
      exactSectionPattern.test(
        result.text || "",
      )
    ) {
      score += 150;
      sectionMatched = true;
      continue;
    }

    const headingPattern =
      new RegExp(
        `(?:^|\\n|\\s)${escapedSection}\\s*\\.`,
        "i",
      );

    if (
      headingPattern.test(
        result.text || "",
      )
    ) {
      score += 120;
      sectionMatched = true;
    }
  }

  if (
    reference.sections.length > 0 &&
    !sectionMatched
  ) {
    return 200;
  }

  return score;
}

/* =========================================================
   STRICT DOCUMENT LEGAL RESULT FILTER
========================================================= */

function filterDocumentLegalResults(
  results: LegalResult[],
  references: ExplicitLegalReference[],
): LegalResult[] {
  if (
    references.length === 0
  ) {
    return results;
  }

  const scored =
    results.map((result) => {
      let bestScore = 0;

      for (
        const reference of
          references
      ) {
        bestScore =
          Math.max(
            bestScore,
            scoreDocumentLegalReference(
              result,
              reference,
            ),
          );
      }

      return {
        result,
        explicitScore:
          bestScore,
      };
    });

  return scored
    .filter(
      ({
        explicitScore,
      }) =>
        explicitScore >= 200,
    )
    .sort(
      (a, b) =>
        b.explicitScore -
        a.explicitScore,
    )
    .map(
      ({ result }) =>
        result,
    );
}

