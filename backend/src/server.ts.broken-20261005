async function getEmbedder() {
  if (!embedder) {
    console.log(`Loading embedding model: ${EMBEDDING_MODEL}`);

    embedder = await pipeline(
      "feature-extraction",
      EMBEDDING_MODEL,
    );

    console.log("Embedding model loaded.");
  }

  return embedder;
}

async function embedQuery(text: string): Promise<number[]> {
  const model = await getEmbedder();

  const output = await model(text, {
    pooling: "cls",
    normalize: true,
  });

  return Array.from(output.data);
}

/* =========================================================
   NORMALIZATION
========================================================= */

function normalizeText(text: string): string {
  return text
    .toLowerCase()
    .replace(/[“”‘’"']/g, " ")
    .replace(/[।,!?;:()[\]{}]/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function normalizeBangla(text: string): string {
  return normalizeText(text)
    .replace(/ভাড়া/g, "ভাড়া")
    .replace(/বাড়িওয়ালা/g, "বাড়িওয়ালা")
    .replace(/বাড়িওয়ালা/g, "বাড়িওয়ালা")
    .replace(/ভাড়াটিয়া/g, "ভাড়াটিয়া")
    .replace(/ভাড়াটী/g, "ভাড়াটিয়া")
    .replace(/বাড়ীর/g, "বাড়ির")
    .replace(/বাড়ি/g, "বাড়ি")
    .replace(/বাড়ী/g, "বাড়ি");
}

function normalizeLegalText(value: unknown): string {
  if (value === null || value === undefined) {
    return "";
  }

  if (typeof value === "string") {
    return value.toLowerCase().trim();
  }

  if (typeof value === "number" || typeof value === "boolean") {
    return String(value).toLowerCase().trim();
  }

  if (Array.isArray(value)) {
    return value
      .map((item) => normalizeLegalText(item))
      .filter(Boolean)
      .join(" ")
      .trim();
  }

  if (typeof value === "object") {
    try {
      return JSON.stringify(value).toLowerCase().trim();
    } catch {
      return "";
    }
  }

  return "";
}

function normalizeActName(value: string): string {
  return normalizeLegalText(value)
    .replace(/\bthe\b/g, "")
    .replace(/\s+/g, " ")
    .trim();
}

/* =========================================================
   COMMUNICATION STYLE
========================================================= */

type CommunicationStyle =
  | "english"
  | "bangla"
  | "banglish";

function detectCommunicationStyle(
  question: string,
): CommunicationStyle {
  const text = question.trim();

  const banglaChars =
    text.match(/[\u0980-\u09FF]/g)?.length ?? 0;

  const latinChars =
    text.match(/[A-Za-z]/g)?.length ?? 0;

  if (banglaChars > 0) {
    return "bangla";
  }

  const lower = text.toLowerCase();

  const banglishMarkers = [
    "ami",
    "amar",
    "amake",
    "amra",
    "amader",
    "apni",
    "apnar",
    "apnake",
    "bariwala",
    "barir malik",
    "barivara",
    "vara",
    "bhara",
    "nibe",
    "nite",
    "chay",
    "chai",
    "chacche",
    "korbo",
    "korben",
    "ki korbo",
    "parbo",
    "parben",
    "hobe",
    "ache",
    "nei",
    "den",
    "diben",
    "bolen",
    "kivabe",
    "keno",
    "jodi",
    "tahole",
    "korte",
    "korar",
    "niye",
    "dite",
  ];

  const looksBanglish = banglishMarkers.some(
    (marker) => lower.includes(marker),
  );

  if (looksBanglish) {
    return "banglish";
  }

  return latinChars > 0
    ? "english"
    : "bangla";
}

