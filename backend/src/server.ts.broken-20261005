type LegalResult = {
  id: string;
  title: string;
  act_file: string;
  start: number;
  end: number;
  text: string;

  sectionNumber?: string | null;

  sourceName?: string | null;
  sourceUrl?: string | null;

  rank?: number;
  similarity?: number;
  lexicalScore?: number;
  exactScore?: number;
  actBoost?: number;
  combinedScore?: number;
  matchedTerms?: string[];
};

/* =========================================================
   LEXICAL SEARCH
========================================================= */

async function lexicalSearch(
  terms: string[],
): Promise<LegalResult[]> {
  const results: LegalResult[] = [];

  for (const term of terms) {
    try {
      const { data, error } =
        await supabase.rpc("search_legal", {
          search_text: term,
          match_count: 12,
        });

      if (error) {
        console.error(
          `Lexical search failed for "${term}":`,
          error.message,
        );
        continue;
      }

      if (Array.isArray(data)) {
        for (const row of data) {
          results.push({
            ...row,
            rank: Number(row.rank || 0),
          });
        }
      }
    } catch (error: any) {
      console.error(
        "Lexical search exception:",
        error?.message || error,
      );
    }
  }

  return results;
}

/* =========================================================
   SEMANTIC SEARCH
========================================================= */

async function semanticSearch(
  question: string,
): Promise<LegalResult[]> {
  const embedding =
    await embedQuery(question);

  const { data, error } =
    await supabase.rpc(
      "match_legal_chunks",
      {
        query_embedding: embedding,
        match_threshold: 0.30,
        match_count: 12,
      },
    );

  if (error) {
    console.error(
      "Semantic search failed:",
      error.message,
    );

    return [];
  }

  return Array.isArray(data)
    ? data.map((row: any) => ({
        ...row,
        similarity: Number(
          row.similarity || 0,
        ),
      }))
    : [];
}

