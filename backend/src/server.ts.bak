  "of",
  "this",
  "that",
]);

function extractLegalSearchTerms(
  question: string,
  intent: LegalIntent,
  retrievalQuery?: string,
): string[] {
  const terms = new Set<string>();

  for (const term of INTENT_TERMS[intent]) {
    terms.add(term);
  }

  const searchText = [
    question,
    retrievalQuery || "",
  ].join(" ");

  const words = normalizeBangla(searchText)
    .split(/\s+/)
    .filter(Boolean)
    .filter(
      (word) => !STOP_WORDS.has(word),
    )
    .filter(
      (word) => word.length >= 3,
    );

  for (const word of words) {
    terms.add(word);
  }

  return Array.from(terms).slice(0, 24);
}

/* =========================================================
   RESULT TYPE
========================================================= */

type LegalResult = {
  id: string;
  title: string;
  act_file: string;
  start: number;
  end: number;
  text: string;
  rank?: number;
  similarity?: number;
  lexicalScore?: number;
  exactScore?: number;
  actBoost?: number;
  combinedScore?: number;
  matchedTerms?: string[];
};

/* =========================================================
   LEXICAL SEARCH
========================================================= */

async function lexicalSearch(
  terms: string[],
): Promise<LegalResult[]> {
  const results: LegalResult[] = [];

  for (const term of terms) {
    try {
      const { data, error } =
        await supabase.rpc("search_legal", {
          search_text: term,
          match_count: 12,
        });

      if (error) {
        console.error(
          `Lexical search failed for "${term}":`,
          error.message,
        );
        continue;
      }

      if (Array.isArray(data)) {
        for (const row of data) {
          results.push({
            ...row,
            rank: Number(row.rank || 0),
          });
        }
      }
    } catch (error: any) {
      console.error(
        "Lexical search exception:",
        error?.message || error,
      );
    }
  }

  return results;
}

/* =========================================================
   SEMANTIC SEARCH
========================================================= */

async function semanticSearch(
  question: string,
): Promise<LegalResult[]> {
  const embedding = await embedQuery(question);

  const { data, error } =
    await supabase.rpc(
      "match_legal_chunks",
      {
        query_embedding: embedding,
        match_threshold: 0.35,
        match_count: 8,
      },
    );

  if (error) {
    console.error(
      "Semantic search failed:",
      error.message,
    );

    /*
     * Semantic search is supplementary.
     * If Supabase vector search times out,
     * lexical retrieval can still provide
     * grounded evidence.
     */
    return [];
  }

  return Array.isArray(data)
    ? data.map((row: any) => ({
        ...row,
        similarity: Number(
          row.similarity || 0,
        ),
      }))
    : [];
}

/* =========================================================
   ACT RELEVANCE
========================================================= */

function isHouseRentAct(
  result: LegalResult,
): boolean {
  const title = normalizeBangla(
    result.title || "",
  );

  return (
    result.act_file === "748.json" ||
    title.includes(
      "বাড়ী ভাড়া নিয়ন্ত্রণ আইন",
    )
  );
}

/* =========================================================
   EXACT SCORE
========================================================= */

function calculateExactScore(
  result: LegalResult,
  intent: LegalIntent,
): number {
  const text = normalizeBangla(
    result.text || "",
  );

  if (intent === "rent_refusal") {
    let score = 0;

    if (
      text.includes(
        "গ্রহণ করিতে অস্বীকার",
      )
    ) {
      score += 1;
    }

    if (
      text.includes("ডাক মনি অর্ডার")
    ) {
      score += 1;
    }

    if (text.includes("ভাড়া জমা")) {
      score += 1;
    }

    if (
      text.includes("বাড়ী-মালিক")
    ) {
      score += 0.5;
    }

    if (
      text.includes("ভাড়াটিয়া")
    ) {
      score += 0.5;
    }

    return Math.min(score / 3, 1);
  }

  if (intent === "rent_receipt") {
    let score = 0;

    if (text.includes("রশিদ")) {
      score += 1;
    }

    if (text.includes("ভাড়া")) {
      score += 1;
    }

    if (
      text.includes("ভাড়াটিয়া")
    ) {
      score += 0.5;
    }

    if (
      text.includes("বাড়ী-মালিক")
    ) {
      score += 0.5;
    }

    return Math.min(score / 2.5, 1);
  }

  return 0;
}

/* =========================================================
   RANK
========================================================= */

function mergeResults(
  question: string,
  intent: LegalIntent,
  lexical: LegalResult[],
  semantic: LegalResult[],
  terms: string[],
): LegalResult[] {
  const map = new Map<
    string,
    LegalResult
  >();

  function add(
    result: LegalResult,
    source:
      | "lexical"
      | "semantic",
  ) {
    const key =
      result.id ||
      `${result.act_file}:${result.start}:${result.end}`;

    const old = map.get(key);

    const lexicalScore =
      source === "lexical"
        ? Math.max(
            Number(result.rank || 0),
            Number(
              old?.lexicalScore || 0,
            ),
          )
        : Number(
            old?.lexicalScore || 0,
          );

    const similarity =
      source === "semantic"
        ? Math.max(
            Number(
              result.similarity || 0,
            ),
            Number(
              old?.similarity || 0,
            ),
          )
        : Number(
            old?.similarity || 0,
          );

    const actBoost =
      intent === "rent_refusal" ||
      intent === "rent_receipt"
        ? isHouseRentAct(result)
          ? 1
          : 0
        : 0;

    const exactScore =
      calculateExactScore(
        result,
        intent,
      );

    const normalizedResultText =
      normalizeBangla(
        result.text || "",
      );

    const matchedTerms =
      Array.from(
        new Set([
          ...(old?.matchedTerms || []),
          ...terms.filter((term) =>
            normalizedResultText.includes(
              normalizeBangla(term),
            ),
          ),
        ]),
      );

    const combinedScore =
      exactScore * 0.5 +
      (Math.min(
        lexicalScore,
        1.5,
      ) /
        1.5) *
        0.25 +
      actBoost * 0.2 +
      Math.min(
        similarity,
        1,
      ) *
        0.05;

    map.set(key, {
      ...(old || result),
      lexicalScore,
      similarity,
      exactScore,
      actBoost,
      combinedScore,
      matchedTerms,
    });
  }

  for (const item of lexical) {
    add(item, "lexical");
  }

  for (const item of semantic) {
    add(item, "semantic");
  }

  let ranked = Array.from(
    map.values(),
  );

  if (
    intent === "rent_refusal" ||
    intent === "rent_receipt"
  ) {
    ranked = ranked.filter(
      (item) =>
        isHouseRentAct(item),
    );
  }

  return ranked
    .sort(
      (a, b) =>
        Number(
          b.combinedScore || 0,
        ) -
        Number(
          a.combinedScore || 0,
        ),
    )
    .slice(0, 10);
}

/* =========================================================
   SECTION EXTRACTION
========================================================= */

const BANGLA_DIGITS =
  "০১২৩৪৫৬৭৮৯";

function banglaDigitsToArabic(
  value: string,
): string {
  return value
    .split("")
    .map((char) => {
      const index =
        BANGLA_DIGITS.indexOf(
          char,
        );

      return index >= 0
        ? String(index)
        : char;
    })
    .join("");
}

type SectionEvidence = {
  sectionNumber: string;
  text: string;
};

function extractSections(
  text: string,
): SectionEvidence[] {
  if (!text) return [];

  const regex =
    /([০-৯]{1,3}|[0-9]{1,3})\s*[।.৷]/g;

  const matches: {
    number: string;
    index: number;
  }[] = [];

  let match: RegExpExecArray | null;

  while (
    (match = regex.exec(text)) !== null
  ) {
    const raw = match[1];

    const number =
      /[০-৯]/.test(raw)
        ? banglaDigitsToArabic(raw)
        : raw;

    const n = Number(number);

    if (
      Number.isInteger(n) &&
      n >= 1 &&
      n <= 999
    ) {
      matches.push({
        number,
        index: match.index,
      });
    }
  }

  const sections: SectionEvidence[] =
    [];

  for (
    let i = 0;
    i < matches.length;
    i++
  ) {
    const current = matches[i];
    const next = matches[i + 1];

    const start = current.index;

    const end = next
      ? next.index
      : text.length;

    const sectionText = text
      .slice(start, end)
      .trim()
      .slice(0, 6500);

    sections.push({
      sectionNumber:
        current.number,
      text: sectionText,
    });
  }

  return sections;
}

/* =========================================================
   CHOOSE SECTION
========================================================= */

function chooseBestSection(
  result: LegalResult,
  intent: LegalIntent,
): SectionEvidence | null {
  const sections = extractSections(
    result.text || "",
  );

  if (sections.length === 0) {
    return null;
  }

  if (
    intent === "rent_refusal" &&
    isHouseRentAct(result)
  ) {
    const section19 =
      sections.find(
        (section) =>
          section.sectionNumber ===
          "19",
      );

    if (section19) {
      return section19;
    }
  }

  if (
    intent === "rent_receipt" &&
    isHouseRentAct(result)
  ) {
    const section13 =
      sections.find(
        (section) =>
          section.sectionNumber ===
          "13",
      );

    if (section13) {
      return section13;
    }
  }

  const canonicalTerms =
    INTENT_TERMS[intent].map(
      normalizeBangla,
    );

  let best:
    | SectionEvidence
    | null = null;

  let bestScore = -1;

  for (const section of sections) {
    const t = normalizeBangla(
      section.text,
    );

    let score = 0;

    for (const term of canonicalTerms) {
      if (t.includes(term)) {
        score++;
      }
    }

    if (score > bestScore) {
      bestScore = score;
      best = section;
    }
  }

  return best;
}

/* =========================================================
   OFFICIAL SOURCE URLS
========================================================= */

type SourceInfo = {
  sourceName: string;
  sourceUrl: string;
};

function getOfficialSource(
  actFile: string,
  sectionNumber: string | null,
): SourceInfo | null {
  if (actFile !== "748.json") {
    return null;
  }

  const actUrl =
    "https://bdlaws.minlaw.gov.bd/act-print-748.html";

  if (sectionNumber === "19") {
    return {
      sourceName:
        "Laws of Bangladesh — বাড়ী ভাড়া নিয়ন্ত্রণ আইন, ১৯৯১, ধারা ১৯",

      sourceUrl:
        "https://bdlaws.minlaw.gov.bd/act-print-748/section-print-30649.html",
    };
  }

  if (sectionNumber === "13") {
    return {
      sourceName:
        "Laws of Bangladesh — বাড়ী ভাড়া নিয়ন্ত্রণ আইন, ১৯৯১, ধারা ১৩",

      sourceUrl:
        "https://bdlaws.minlaw.gov.bd/act-print-748/section-print-30643.html",
    };
  }

  return {
    sourceName:
      "Laws of Bangladesh — বাড়ী ভাড়া নিয়ন্ত্রণ আইন, ১৯৯১",

    sourceUrl: actUrl,
  };
}

/* =========================================================
   EVIDENCE
========================================================= */

type EvidenceItem = {
  id: string;
  title: string;
  actFile: string;
  sectionNumber: string | null;
  text: string;
  sourceName?: string;
  sourceUrl?: string;
};

function buildEvidence(
  results: LegalResult[],
  intent: LegalIntent,
): EvidenceItem[] {
  const output: EvidenceItem[] = [];

  /*
   * RENT REFUSAL
   *
   * Only Section 19 is supplied.
   */
  if (intent === "rent_refusal") {
    for (const result of results) {
      if (!isHouseRentAct(result)) {
        continue;
      }

      const section =
        chooseBestSection(
          result,
          intent,
        );

      if (!section) {
        continue;
      }

      if (
        section.sectionNumber !==
        "19"
      ) {
        continue;
      }

      const source =
        getOfficialSource(
          result.act_file,
          "19",
        );

      output.push({
        id: "C1",
        title: result.title,
        actFile: result.act_file,
        sectionNumber: "19",
        text: section.text,
        sourceName:
          source?.sourceName,
        sourceUrl:
          source?.sourceUrl,
      });

      break;
    }

    return output;
  }

  /*
   * RENT RECEIPT
   *
   * Section 13 is the relevant
   * receipt provision.
   */
  if (intent === "rent_receipt") {
    for (const result of results) {
      if (!isHouseRentAct(result)) {
        continue;
      }

      const section =
        chooseBestSection(
          result,
          intent,
        );

      if (!section) {
        continue;
      }

      if (
        section.sectionNumber !==
        "13"
      ) {
        continue;
      }

      const source =
        getOfficialSource(
          result.act_file,
          "13",
        );

      output.push({
        id: "C1",
        title: result.title,
        actFile: result.act_file,
        sectionNumber: "13",
        text: section.text,
        sourceName:
          source?.sourceName,
        sourceUrl:
          source?.sourceUrl,
      });

      break;
    }

    return output;
  }

  /*
   * GENERIC FALLBACK
   */

  for (const result of results) {
    const section =
      chooseBestSection(
        result,
        intent,
      );

    if (!section) {
      continue;
    }

    const duplicate =
      output.some(
        (item) =>
          item.actFile ===
            result.act_file &&
          item.sectionNumber ===
            section.sectionNumber,
      );

    if (duplicate) {
      continue;
    }

    const source =
      getOfficialSource(
        result.act_file,
        section.sectionNumber,
      );

    output.push({
      id: `C${output.length + 1}`,
      title: result.title,
      actFile: result.act_file,
      sectionNumber:
        section.sectionNumber,
      text: section.text,
      sourceName:
        source?.sourceName,
      sourceUrl:
        source?.sourceUrl,
    });

    if (output.length >= 4) {
      break;
    }
  }

  return output;
}

/* =========================================================
   GROQ SYSTEM PROMPT
========================================================= */

function systemPrompt(): string {
  return `
You are AinBodh, a Bangladesh-law information assistant.

You MUST answer only from the supplied legal evidence.

========================================================
STRICT LEGAL RULES
========================================================

1. NEVER invent a section number.

2. NEVER mention a section number unless that exact section
   number appears in the supplied evidence.

3. If the evidence says Section 19, say Section 19.

4. If another section is mentioned INSIDE the legal text but
   that other section is not supplied as separate evidence,
   DO NOT explain or rely on that other section.

5. NEVER turn permissive language into mandatory language.

"পারিবেন" means may/can.

"করিতে পারিবেন" means may/can.

"করিতে হইবে" means must/shall.

"বাধ্য" means required/obliged.

Preserve the legal force exactly.

6. NEVER invent:

- procedures
- complaint routes
- regulator instructions
- court procedures
- penalties
- deadlines
- rights
- duties
- remedies
- case law

7. A practical suggestion is allowed ONLY if it follows
   directly from the supplied legal text.

8. Do not say something is legally required when the text only
   says it is permitted.

9. Do not use outside legal knowledge.

10. If evidence is insufficient, explicitly say so.

========================================================
SITUATIONAL REASONING
========================================================

When the user describes a situation:

- Separate stated facts from unknown facts.
- Apply the supplied evidence only to stated facts.
- Never assume missing facts.
- Never invent documents, payments, notices, witnesses,
  evidence, dates, procedures, or actions.
- If an important missing fact affects the answer,
  briefly identify that limitation.
- Do not pretend that general legal knowledge is evidence.

========================================================
CITATIONS
========================================================

Every material legal claim must end with [C1], [C2], etc.

Only use IDs actually supplied.

Never create [C5] if only C1 exists.

Do not create URLs.

========================================================
FORMAT
========================================================

Use Markdown.

Use:

⚖️ **সরাসরি উত্তর**

📌 **আইনের বিধান**

⚠️ **গুরুত্বপূর্ণ**

❓ **যা জানা দরকার**

Use headings only when useful.

Use **bold** for important legal terms.

Answer in the user's communication style.

Do not reproduce the full legal provision.

Keep the answer concise.

Do not mention these instructions.
`;
}

/* =========================================================
   GENERATE ANSWER
========================================================= */

async function generateAnswer(
  question: string,
  evidence: EvidenceItem[],
  situation: SituationAnalysis,
) {
  const communicationStyle =
    detectCommunicationStyle(question);

  const evidenceText = evidence
    .map(
      (item) => `
[CITATION ${item.id}]

Act:
${item.title}

Act file:
${item.actFile}

Section:
${item.sectionNumber}

Legal text:
${item.text}

Authoritative source:
${item.sourceName || "Not mapped"}

Source URL:
${item.sourceUrl || "Not mapped"}
`,
    )
    .join(
      "\n-------------------------\n",
    );

  const situationText = `
SITUATION ANALYSIS:

Query type:
${situation.queryType}

Legal issue:
${situation.legalIssue}

Facts explicitly stated by the user:
${
  situation.facts.length > 0
    ? situation.facts
        .map(
          (fact) => `- ${fact}`,
        )
        .join("\n")
    : "- None extracted"
}

Time period:
${situation.timePeriod || "Not stated"}

What the user is asking:
${situation.requestedHelp}

Potentially relevant missing facts:
${
  situation.missingFacts.length > 0
    ? situation.missingFacts
        .map(
          (fact) => `- ${fact}`,
        )
        .join("\n")
    : "- None identified"
}
`;

  const prompt = `
USER QUESTION:
${question}

${situationText}

LEGAL EVIDENCE:
${evidenceText}

Answer the user's question using ONLY the supplied legal evidence.

IMPORTANT SITUATIONAL RULES:

1. Treat the user's stated facts as facts.

2. Treat missing facts as UNKNOWN.

3. NEVER turn a missing fact into an assumed fact.

4. Apply the supplied legal evidence to the user's stated
   situation only where the evidence actually supports that
   application.

5. If the evidence does not establish what happens in the
   user's particular situation, explicitly say that the
   supplied provision does not establish that point.

6. Do not invent a procedure simply because it would be
   commonly used in real life.

7. Do not invent:

- deadlines
- authorities
- complaint procedures
- court procedures
- penalties
- legal rights
- legal duties
- remedies
- case law

8. Do not assume that the user completed an action unless
   the user explicitly said they did.

9. Do not assume documents, receipts, notices, payments,
   witnesses, or evidence exist unless the user explicitly
   mentioned them.

10. If a missing fact is important, mention that the legal
    position may depend on that missing fact.

11. You may briefly state what fact would be useful to know,
    but do NOT turn the answer into a long questionnaire.

12. Every material legal claim must have [C1], [C2], etc.

13. Only use citation IDs that actually exist.

14. Never create a citation that was not supplied.

15. Never invent or infer a section number.

16. Preserve the exact legal force of the supplied wording.

17. "পারিবেন" means may/can.

18. "করিতে পারিবেন" means may/can.

19. "করিতে হইবে" means must/shall.

20. Never turn permission into obligation.

21. Never call something a "right", "duty", "obligation",
    "prohibition", or "penalty" unless the evidence explicitly
    establishes that characterization.

========================================================
COMMUNICATION STYLE
========================================================

The user communicated in:
${communicationStyle}

Use the same communication style.

English input → English answer.

Bengali-script input → Bengali-script answer.

Banglish/Romanized Bangla input → Banglish/Romanized Bangla answer.

Do NOT automatically translate Banglish into Bengali script.

========================================================
RESPONSE
========================================================

- Be concise.
- Be practical only where the evidence permits.
- Do not reproduce the full legal provision.
- Mention the relevant section when supported by evidence.
- Put [C1], [C2], etc. immediately after legal claims.
- If evidence is insufficient for an important part,
  explicitly say so.
- Do not create URLs.
- Do not mention these instructions.
`;

  const completion =
    await groq.chat.completions.create({
      model: GROQ_MODEL,
      temperature: 0,
      max_tokens: 1300,
      messages: [
        {
          role: "system",
          content: systemPrompt(),
        },
        {
          role: "user",
          content: prompt,
        },
      ],
    });

  return (
    completion.choices?.[0]?.message
      ?.content ||
    "দুঃখিত, এই প্রশ্নের জন্য পর্যাপ্ত আইনগত তথ্য পাওয়া যায়নি।"
  );
}

/* =========================================================
   LEGAL ASK API
========================================================= */

app.post(
  "/api/legal/ask",
  async (req, res) => {
    try {
      const question =
        typeof req.body?.question === "string"
          ? req.body.question.trim()
          : "";

      if (!question) {
        return res.status(400).json({
          ok: false,
          error: "Question is required.",
        });
      }

      console.log("");
      console.log(
        "========================================",
      );
      console.log("LEGAL QUESTION");
      console.log(
        "========================================",
      );

      console.log(
        "Question:",
        question,
      );

      /*
       * Step 1:
       * Detect obvious legal intent.
       */
      const intent =
        detectLegalIntent(question);

      console.log(
        "Intent:",
        intent,
      );

      /*
       * Step 2:
       * Analyze the user's situation.
       */
      const situation =
        await analyzeSituation(
          question,
          intent,
        );

      console.log(
        "Query type:",
        situation.queryType,
      );

      console.log(
        "Legal issue:",
        situation.legalIssue,
      );

      console.log(
        "Retrieval query:",
        situation.retrievalQuery,
      );

      /*
       * Step 3:
       * Build retrieval terms using both:
       * original input + normalized legal query.
       */
      const searchTerms =
        extractLegalSearchTerms(
          question,
          intent,
          situation.retrievalQuery,
        );

      console.log(
        "Search terms:",
        searchTerms,
      );

      /*
       * Step 4:
       * Lexical + semantic retrieval.
       */
     const lexicalResults =
  await lexicalSearch(searchTerms);

let semanticResults: LegalResult[] = [];

try {
semanticResults = await semanticSearch(
  situation.retrievalQuery || question
);
} catch (error) {
  console.error(
    "Optional semantic retrieval failed:",
    error,
  );
}

      console.log(
        "Lexical results:",
        lexicalResults.length,
      );

      console.log(
        "Semantic results:",
        semanticResults.length,
      );

      /*
       * Step 5:
       * Merge and rank.
       */
      const rankedResults =
        mergeResults(
          question,
          intent,
          lexicalResults,
          semanticResults,
          searchTerms,
        );

      console.log(
        "Ranked results:",
        rankedResults.length,
      );

      /*
       * Step 6:
       * Build authoritative evidence.
       */
      const evidence =
        buildEvidence(
          rankedResults,
          intent,
        );

      console.log(
        "Evidence:",
        evidence.map(
          (item) =>
            `${item.id}: ${item.title} Section ${item.sectionNumber}`,
        ),
      );

      /*
       * Step 7:
       * Never allow an unsupported answer.
       */
      if (evidence.length === 0) {
        const style =
          detectCommunicationStyle(
            question,
          );

        let answer =
          "এই প্রশ্নের জন্য উপলব্ধ বাংলাদেশি আইনগত তথ্য থেকে পর্যাপ্ত প্রাসঙ্গিক বিধান পাওয়া যায়নি।";

        if (style === "english") {
          answer =
            "I could not retrieve a sufficiently relevant provision from the available Bangladesh-law evidence for this question.";
        }

        if (style === "banglish") {
          answer =
            "Ei proshner jonno available Bangladesh-law evidence theke jothesto relevant provision retrieve kora jayni.";
        }

        console.log(
          "No sufficient legal evidence found.",
        );

        return res.json({
          ok: true,
          grounded: false,
          answer,
          citations: [],
          intent,
          situation,
        });
      }

      /*
       * Step 8:
       * Generate grounded answer.
       */
      const answer =
        await generateAnswer(
          question,
          evidence,
          situation,
        );

      console.log(
        "========================================",
      );

      return res.json({
        ok: true,
        grounded: true,
        answer,
        citations: evidence.map(
          (item) => ({
            id: item.id,
            title: item.title,
            section:
              item.sectionNumber,
            sourceName:
              item.sourceName,
            sourceUrl:
              item.sourceUrl,
          }),
        ),
        intent,
        situation,
      });
    } catch (error) {
      console.error(
        "LEGAL ASK ERROR:",
        error,
      );

      const message =
        error instanceof Error
          ? error.message
          : "Legal answer generation failed.";

      return res.status(500).json({
        ok: false,
        error: message,
      });
    }
  },
);

/* =========================================================
   START
========================================================= */

app.listen(PORT, () => {
  console.log(
    `AinBodh backend running at http://127.0.0.1:${PORT}`,
  );
});