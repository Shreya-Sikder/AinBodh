import express from "express";
import cors from "cors";
import "dotenv/config";
import Groq from "groq-sdk";
import { pipeline } from "@xenova/transformers";
import { supabase } from "./supabase";
import multer from "multer";
import { extractDocument } from "./documentExtractor";

const app = express();

app.use(cors());
app.use(express.json({ limit: "10mb" }));

const documentUpload = multer({
  storage: multer.memoryStorage(),
  limits: {
    fileSize: 15 * 1024 * 1024,
    files: 1,
  },
});

const PORT = Number(process.env.PORT || 5000);

const groq = new Groq({
  apiKey: process.env.GROQ_API_KEY,
});

const EMBEDDING_MODEL = "Xenova/bge-m3";
const GROQ_MODEL = "openai/gpt-oss-120b";

let embedder: any = null;

/* =========================================================
   DOCUMENT EXTRACTION
========================================================= */

app.post(
  "/api/legal/extract",
  documentUpload.single("file"),
  async (req, res) => {
    try {
      if (!req.file) {
        return res.status(400).json({
          ok: false,
          error: "No file was uploaded.",
        });
      }

      console.log("");
      console.log("========================================");
      console.log("DOCUMENT EXTRACTION");
      console.log("========================================");
      console.log(`File: ${req.file.originalname}`);
      console.log(`Size: ${req.file.size} bytes`);
      console.log(`MIME: ${req.file.mimetype}`);

      const document = await extractDocument(
        req.file.buffer,
        req.file.originalname,
        req.file.mimetype,
      );

      console.log(`Pages: ${document.pages}`);
      console.log(`Method: ${document.extractionMethod}`);
      console.log(`Characters: ${document.text.length}`);
      console.log("========================================");

      return res.json({
        ok: true,
        document,
      });
    } catch (error) {
      console.error(
        "DOCUMENT EXTRACTION ERROR:",
        error,
      );

      const message =
        error instanceof Error
          ? error.message
          : "Document extraction failed.";

      return res.status(400).json({
        ok: false,
        error: message,
      });
    }
  },
);

/* =========================================================
   BASIC
========================================================= */

app.get("/", (_req, res) => {
  res.json({
    ok: true,
    service: "AinBodh Legal API",
  });
});

app.get("/test-supabase", async (_req, res) => {
  try {
    const { data, error } = await supabase
      .from("legal_metadata")
      .select("*")
      .limit(1);

    if (error) {
      return res.status(500).json({
        ok: false,
        error: error.message,
      });
    }

    return res.json({
      ok: true,
      sample: data,
    });
  } catch (error: any) {
    return res.status(500).json({
      ok: false,
      error: error?.message || "Unknown error",
    });
  }
});

/* =========================================================
   EMBEDDING
========================================================= */

async function getEmbedder() {
  if (!embedder) {
    console.log(
      `Loading embedding model: ${EMBEDDING_MODEL}`,
    );

    embedder = await pipeline(
      "feature-extraction",
      EMBEDDING_MODEL,
    );

    console.log("Embedding model loaded.");
  }

  return embedder;
}

async function embedQuery(
  text: string,
): Promise<number[]> {
  const model = await getEmbedder();

  const output = await model(text, {
    pooling: "cls",
    normalize: true,
  });

  return Array.from(output.data);
}

/* =========================================================
   NORMALIZATION
========================================================= */

function normalizeText(text: string): string {
  return text
    .toLowerCase()
    .replace(/[“”‘’"']/g, " ")
    .replace(/[।,!?;:()[\]{}]/g, " ")
    .replace(/\s+/g, " ")
    .trim();
}

function normalizeBangla(text: string): string {
  return normalizeText(text)
    .replace(/ভাড়া/g, "ভাড়া")
    .replace(/বাড়িওয়ালা/g, "বাড়িওয়ালা")
    .replace(/বাড়িওয়ালা/g, "বাড়িওয়ালা")
    .replace(/ভাড়াটিয়া/g, "ভাড়াটিয়া")
    .replace(/ভাড়াটী/g, "ভাড়াটিয়া")
    .replace(/বাড়ীর/g, "বাড়ীর")
    .replace(/বাড়ি/g, "বাড়ি")
    .replace(/বাড়ী/g, "বাড়ী");
}

/* =========================================================
   COMMUNICATION STYLE
========================================================= */

type CommunicationStyle =
  | "english"
  | "bangla"
  | "banglish";

function detectCommunicationStyle(
  question: string,
): CommunicationStyle {
  const text = question.trim();

  const banglaChars =
    text.match(/[\u0980-\u09FF]/g)?.length ?? 0;

  const latinChars =
    text.match(/[A-Za-z]/g)?.length ?? 0;

  if (banglaChars > 0) {
    return "bangla";
  }

  const lower = text.toLowerCase();

  const banglishMarkers = [
    "ami",
    "amar",
    "amake",
    "amra",
    "amader",
    "apni",
    "apnar",
    "apnake",
    "bariwala",
    "barir malik",
    "barivara",
    "vara",
    "bhara",
    "nibe",
    "nite",
    "chay",
    "chai",
    "chacche",
    "korbo",
    "korben",
    "ki korbo",
    "parbo",
    "parben",
    "hobe",
    "ache",
    "nei",
    "den",
    "diben",
    "bolen",
    "kivabe",
    "keno",
    "jodi",
    "tahole",
    "korte",
    "korar",
    "niye",
    "dite",
    "nite",
  ];

  const looksBanglish = banglishMarkers.some(
    (marker) =>
      lower.includes(marker),
  );

  if (looksBanglish) {
    return "banglish";
  }

  return latinChars > 0
    ? "english"
    : "bangla";
}

/* =========================================================
   LEGAL INTENT
========================================================= */

type LegalIntent =
  | "rent_refusal"
  | "rent_receipt"
  | "eviction"
  | "unknown";

function detectLegalIntent(question: string): LegalIntent {
  const text = normalizeBangla(question);

  const hasRent =
    text.includes("ভাড়া") ||
    text.includes("ভাড়") ||
    text.includes("rent");

  const hasLandlordTenant =
    text.includes("বাড়িওয়ালা") ||
    text.includes("বাড়ী-মালিক") ||
    text.includes("বাড়ির মালিক") ||
    text.includes("বাড়িওয়ালা") ||
    text.includes("বাড়ির মালিক") ||
    text.includes("landlord") ||
    text.includes("tenant") ||
    text.includes("ভাড়াটিয়া") ||
    text.includes("ভাড়াটিয়া");

  const rentRefusalTerms = [
    "ভাড়া গ্রহণ করিতে অস্বীকার",
    "গ্রহণ করিতে অস্বীকার",
    "ভাড়া গ্রহণ করতে অস্বীকার",
    "ভাড়া গ্রহণ করতে চাইছে না",
    "ভাড়া গ্রহণ করতে চাচ্ছে না",
    "ভাড়া নিতে অস্বীকার",
    "ভাড়া নিতে অস্বীকার করছে",
    "ভাড়া নিতে চাইছে না",
    "ভাড়া নিতে চাচ্ছে না",
    "ভাড়া নিচ্ছে না",
    "ভাড়া নিচ্ছেন না",
    "ভাড়া নেয় না",
    "ভাড়া নেয় না",
    "ভাড়া গ্রহণ করতে অস্বীকার",
    "ভাড়া গ্রহণ করতে চাইছে না",
    "ভাড়া গ্রহণ করতে চাচ্ছে না",
    "ভাড়া নিতে অস্বীকার",
    "ভাড়া নিতে অস্বীকার করছে",
    "ভাড়া নিতে চাইছে না",
    "ভাড়া নিতে চাচ্ছে না",
    "ভাড়া নিচ্ছে না",
    "ভাড়া নিচ্ছেন না",
    "ভাড়া নেয় না",
    "rent refused",
    "refused to accept rent",
    "refuses to accept rent",
    "won't accept rent",
    "will not accept rent",
    "not accepting rent",
  ];

  const receiptTerms = [
    "ভাড়ার রশিদ",
    "ভাড়ার রশিদ",
    "রশিদ প্রদান",
    "ভাড়া পরিশোধের রশিদ",
    "ভাড়ার receipt",
    "rent receipt",
    "receipt for rent",
  ];

  const evictionTerms = [
    "উচ্ছেদ",
    "উচ্ছেদের নোটিশ",
    "উচ্ছেদ নোটিশ",
    "বাড়ি থেকে বের করে",
    "বাড়ি থেকে বের করে",
    "বের করে দিতে",
    "বের করে দেবে",
    "eviction",
    "eviction notice",
    "evict",
  ];

  if (
    hasRent &&
    (hasLandlordTenant || rentRefusalTerms.some((term) => text.includes(term))) &&
    rentRefusalTerms.some((term) => text.includes(term))
  ) {
    return "rent_refusal";
  }

  if (
    hasRent &&
    (hasLandlordTenant || receiptTerms.some((term) => text.includes(term))) &&
    receiptTerms.some((term) => text.includes(term))
  ) {
    return "rent_receipt";
  }

  if (
    evictionTerms.some((term) => text.includes(term)) &&
    (hasLandlordTenant || hasRent)
  ) {
    return "eviction";
  }

  /*
   * Conversational fallback:
   * Detect the common situation where the user describes
   * a landlord refusing/not accepting rent without using
   * formal legal wording such as "অস্বীকার".
   */
  const landlordRefusingRent =
    hasRent &&
    hasLandlordTenant &&
    (
      text.includes("নিতে চাচ্ছে না") ||
      text.includes("নিতে চাইছে না") ||
      text.includes("নিচ্ছে না") ||
      text.includes("নিচ্ছেন না") ||
      text.includes("গ্রহণ করছে না") ||
      text.includes("গ্রহণ করছেন না") ||
      text.includes("গ্রহণ করতে চাচ্ছে না") ||
      text.includes("গ্রহণ করতে চাইছে না") ||
      text.includes("accept করছে না") ||
      text.includes("accept করতে চাচ্ছে না") ||
      text.includes("accept করতে চাইছে না") ||
      text.includes("refused") ||
      text.includes("refuse") ||
      text.includes("not accepting")
    );

  if (landlordRefusingRent) {
    return "rent_refusal";
  }

  return "unknown";
}
/* =========================================================
   SITUATION ANALYSIS
========================================================= */

type SituationAnalysis = {
  queryType:
    | "direct"
    | "situational";

  legalIssue: string;

  facts: string[];

  timePeriod: string | null;

  requestedHelp: string;

  missingFacts: string[];

  retrievalQuery: string;
};

function fallbackSituationAnalysis(
  question: string,
  intent: LegalIntent,
): SituationAnalysis {
  let legalIssue = "Unknown legal issue";

  if (intent === "rent_refusal") {
    legalIssue =
      "landlord refusing to accept rent";
  } else if (intent === "rent_receipt") {
    legalIssue = "rent receipt";
  } else if (intent === "eviction") {
    legalIssue = "eviction";
  }

  const communicationStyle =
    detectCommunicationStyle(question);

  const looksLikeQuestion =
    /\b(what|why|how|can|could|would|should)\b/i.test(
      question,
    ) ||
    question.includes("কি") ||
    question.includes("কী") ||
    question.includes("কেন") ||
    question.includes("কিভাবে") ||
    question.includes("কীভাবে") ||
    question.includes("korbo") ||
    question.includes("kivabe") ||
    question.includes("keno");

  return {
    queryType: looksLikeQuestion
      ? "situational"
      : "direct",

    legalIssue,

    facts: [question.trim()],

    timePeriod: null,

    requestedHelp: question.trim(),

    missingFacts: [],

    retrievalQuery:
      communicationStyle === "banglish"
        ? `${question} ${legalIssue}`
        : `${question} ${legalIssue}`,
  };
}

async function analyzeSituation(
  question: string,
  intent: LegalIntent,
): Promise<SituationAnalysis> {
  const communicationStyle =
    detectCommunicationStyle(question);

  const prompt = `
Analyze this user's input for Bangladesh legal-information retrieval.

IMPORTANT:
A user's situation may contain more than one legal issue.
Identify all clearly supported legal issues, not just the first one.

For example:
"My landlord refused my rent for two months and now told me to leave."

Possible issues:
- rent payment refusal
- eviction concern

Do not invent an issue that is not supported by the user's words.
- This is ONLY query analysis.
- Do NOT provide legal advice.
- Do NOT determine whether the user has a legal right.
- Do NOT invent facts.
- Do NOT invent laws or section numbers.
- Extract only facts explicitly stated by the user.
- Normalize informal, conversational, or Banglish wording into
  neutral legal concepts.
- Preserve the user's actual situation.
- The retrievalQuery is ONLY a neutral description of the legal
  issue and facts needed to find relevant legislation.
- Do NOT add words such as "rights", "obligation", "illegal",
  "case law", "remedy", "penalty", or similar legal conclusions
  unless the user explicitly used them.
- Do NOT add laws or section numbers that were not supplied.
- Do NOT add Bangladesh-specific legislation names unless they
  are already known from the detected intent.

USER INPUT:
${question}

DETECTED LEGAL INTENT:
${intent}

COMMUNICATION STYLE:
${communicationStyle}

Return ONLY valid JSON in exactly this structure:

{
  "queryType": "direct" | "situational",
  "legalIssue": "short description",
  "facts": ["only explicitly stated facts"],
  "timePeriod": "explicitly stated time period or null",
  "requestedHelp": "what the user is asking",
  "missingFacts": ["facts that could matter but were not provided"],
"retrievalQuery": "short neutral legal issue for retrieval; no legal conclusions"
}

Rules for missingFacts:
- Only identify information that could materially affect legal analysis.
- Do not invent missing facts.
- Do not ask the user questions here.

Do NOT answer the user's question.
`;

  try {
    const completion =
      await groq.chat.completions.create({
        model: GROQ_MODEL,
        temperature: 0,
        max_tokens: 700,
        messages: [
          {
            role: "system",
            content:
              "You are a legal-query analysis engine. Return JSON only.",
          },
          {
            role: "user",
            content: prompt,
          },
        ],
      });

    const raw =
      completion.choices?.[0]?.message?.content
        ?.trim();

    if (!raw) {
      return fallbackSituationAnalysis(
        question,
        intent,
      );
    }

    const cleaned = raw
      .replace(/^```json\s*/i, "")
      .replace(/^```\s*/i, "")
      .replace(/\s*```$/i, "")
      .trim();

    const parsed =
      JSON.parse(
        cleaned,
      ) as Partial<SituationAnalysis>;

    return {
      queryType:
        parsed.queryType === "situational"
          ? "situational"
          : "direct",

      legalIssue:
        typeof parsed.legalIssue === "string"
          ? parsed.legalIssue
          : "Unknown legal issue",

      facts:
        Array.isArray(parsed.facts)
          ? parsed.facts.filter(
              (item): item is string =>
                typeof item === "string",
            )
          : [],

      timePeriod:
        typeof parsed.timePeriod === "string"
          ? parsed.timePeriod
          : null,

      requestedHelp:
        typeof parsed.requestedHelp === "string"
          ? parsed.requestedHelp
          : question,

      missingFacts:
        Array.isArray(parsed.missingFacts)
          ? parsed.missingFacts.filter(
              (item): item is string =>
                typeof item === "string",
            )
          : [],

      retrievalQuery:
        typeof parsed.retrievalQuery === "string" &&
        parsed.retrievalQuery.trim()
          ? parsed.retrievalQuery.trim()
          : question,
    };
  } catch (error) {
    console.error(
      "SITUATION ANALYSIS FAILED:",
      error,
    );

    return fallbackSituationAnalysis(
      question,
      intent,
    );
  }
}

/* =========================================================
   SEARCH TERMS
========================================================= */

const INTENT_TERMS: Record<
  LegalIntent,
  string[]
> = {
  rent_refusal: [
    "ভাড়া গ্রহণ করিতে অস্বীকার",
    "গ্রহণ করিতে অস্বীকার",
    "ভাড়া জমা",
    "ডাক মনি অর্ডার",
    "মনি অর্ডার",
    "বাড়ী-মালিক",
    "ভাড়াটিয়া",
  ],

  rent_receipt: [
    "ভাড়ার রশিদ",
    "রশিদ প্রদান",
    "ভাড়া পরিশোধ",
    "বাড়ী-মালিক",
    "ভাড়াটিয়া",
  ],

  eviction: [
    "উচ্ছেদ",
    "উচ্ছেদের নোটিশ",
    "ভাড়া বকেয়া",
    "বাড়ী-মালিক",
    "ভাড়াটিয়া",
  ],

  unknown: [],
};

const STOP_WORDS = new Set([
  "আমি",
  "আমার",
  "আমাকে",
  "আমরা",
  "আমাদের",
  "আপনি",
  "আপনার",
  "এই",
  "ওই",
  "একটি",
  "একজন",
  "কি",
  "কী",
  "কেন",
  "কিভাবে",
  "কীভাবে",
  "কোন",
  "কোনো",
  "যদি",
  "তাহলে",
  "যে",
  "যা",
  "তা",
  "এবং",
  "বা",
  "কিন্তু",
  "থেকে",
  "জন্য",
  "সাথে",
  "করে",
  "করতে",
  "করব",
  "করবো",
  "হয়",
  "হয়",
  "হবে",
