# Copy to backend/.env and fill in. Never commit the real .env.

# Required
GROQ_API_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server
PORT=5000
NODE_ENV=development
# Comma-separated browser origins allowed to call the API ("*" = any)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
RATE_LIMIT_PER_MINUTE=30
# Set to true behind a reverse proxy (nginx, Render, Railway...) so rate limits use the real client IP
TRUST_PROXY=false
# true = every API call needs a signed-in user (Supabase Auth). Turn on for public deployment,
# together with VITE_SUPABASE_URL / VITE_SUPABASE_ANON_KEY in the frontend .env.
REQUIRE_AUTH=false
# VOICE_RATE_LIMIT_PER_MINUTE=20
# TTS_RATE_LIMIT_PER_MINUTE=120

# Model
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT_MS=60000

# Legal corpus (defaults shown). Used for repealed-law detection and concept search.
# LEGAL_CORPUS_PATH=../data/rag_passages.jsonl
# LAW_STATUS_PATH=./data/law-status.json

# bdlaws section links + live law status
# BDLAWS_TIMEOUT_MS=6000
# BDLAWS_CACHE_DIR=./cache
# Re-read each act page after this many hours to catch new repeals
# BDLAWS_STATUS_TTL_HOURS=24
# Check cited laws against live bdlaws before answering (set false only if bdlaws is unreachable)
# BDLAWS_LIVE_CHECK=true
# Max time per question spent on live checks
# BDLAWS_LIVE_BUDGET_MS=12000
# Output of `npx tsx src/syncBdlaws.ts`
# LIVE_UPDATES_PATH=./data/live-updates.json

# Read-aloud for Bangla (most browsers on Windows have no Bangla voice):
#   auto (default) = azure if configured, else google, else edge
#   azure  = official Microsoft voice bn-BD-NabanitaNeural (free tier available) — recommended
#   google = official Google voice (bn-IN)
#   edge   = no key needed; unofficial Microsoft Edge read-aloud service, may stop working
#   off    = disable server read-aloud
TTS_PROVIDER=auto
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# GOOGLE_TTS_API_KEY=
# TTS_ALLOW_EDGE=true

# Voice input fallback (browsers without live speech recognition) uses Groq Whisper with GROQ_API_KEY.
# GROQ_STT_MODEL=whisper-large-v3

# OCR language files (eng.traineddata, ben.traineddata); default: the backend folder
# TESSDATA_DIR=

# Logs user questions/documents to the console. Keep false outside local debugging.
LOG_USER_CONTENT=false
