/* =========================================================
   NORMALIZE CITATION
========================================================= */

function normalizeCitation(
  item: unknown,
  index: number,
): LegalCitation | null {
  if (
    !item ||
    typeof item !== "object"
  ) {
    return null;
  }

  const citation =
    item as Record<
      string,
      unknown
    >;

  const title =
    typeof citation.title ===
    "string"
      ? citation.title
      : typeof citation.actFile ===
          "string"
        ? citation.actFile
        : "";

  if (!title) {
    return null;
  }

  return {
    id:
      typeof citation.id ===
      "string"
        ? citation.id
        : `C${index + 1}`,

    title,

    actFile:
      typeof citation.actFile ===
      "string"
        ? citation.actFile
        : "",

    sectionNumber:
      typeof citation.sectionNumber ===
      "string"
        ? citation.sectionNumber
        : typeof citation.sectionNumber ===
            "number"
          ? String(
              citation.sectionNumber,
            )
          : null,

    content:
      typeof citation.content ===
      "string"
        ? citation.content
        : "",

    sourceName:
      typeof citation.sourceName ===
      "string"
        ? citation.sourceName
        : undefined,

    sourceUrl:
      typeof citation.sourceUrl ===
      "string"
        ? citation.sourceUrl
        : undefined,

  };
}

/* =========================================================
   ASK LEGAL QUESTION
========================================================= */

export async function askQuestion(
  question: string,
  documentId?: string,
  history: ChatMessage[] = [],
  language: "en" | "bn" = "en",
): Promise<ChatResponse> {
  const response =
    await fetch(
      `${API_BASE_URL}/api/legal/ask`,
      {
        method: "POST",

        headers: {
          "Content-Type":
            "application/json",
        },

        body: JSON.stringify({
  question,
  documentId,
  history,
  language,
}),
      },
    );

  let data:
    Record<string, unknown>;

  try {
    data =
      await response.json();
  } catch {
    throw new Error(
      "The legal server returned an unreadable response. Please try again.",
    );
  }

  if (!response.ok) {
    const message =
      typeof data.error ===
      "string"
        ? data.error
        : `Server error (${response.status}).`;

    throw new Error(message);
  }

  if (data.ok === false) {
    throw new Error(
      typeof data.error ===
      "string"
        ? data.error
        : "The legal server could not answer this question.",
    );
  }

  const answer =
    typeof data.answer ===
    "string"
      ? data.answer.trim()
      : "";

  if (!answer) {
    throw new Error(
      "The server returned an empty answer. Check the backend logs.",
    );
  }

  const citations =
    Array.isArray(
      data.citations,
    )
      ? data.citations
          .map(
            normalizeCitation,
          )
          .filter(
            (
              item,
            ): item is LegalCitation =>
              item !== null,
          )
      : [];

  return {
    answer,
    citations,
    grounded:
      data.grounded === true,
  };
}

/* =========================================================
   COMPARE DOCUMENTS
========================================================= */

export async function compareDocuments(
  documents: CompareDocumentInput[],
  language: "en" | "bn",
): Promise<CompareResponse> {
  if (documents.length < 2) {
    throw new Error(
      "At least two documents are required for comparison.",
    );
  }

  const validDocuments =
    documents.filter(
      (document) =>
        document &&
        typeof document.name ===
          "string" &&
        typeof document.text ===
          "string" &&
        document.name.trim() &&
        document.text.trim(),
    );

  if (validDocuments.length < 2) {
    throw new Error(
      "At least two readable documents are required for comparison.",
    );
  }

  const response =
    await fetch(
      `${API_BASE_URL}/api/legal/compare`,
      {
        method: "POST",

        headers: {
          "Content-Type":
            "application/json",
        },

        body: JSON.stringify({
          documents:
            validDocuments,
          language,
        }),
      },
    );

  let data:
    Record<string, unknown>;

  try {
    data =
      await response.json();
  } catch {
    throw new Error(
      "The legal server returned an unreadable response. Please try again.",
    );
  }

  if (
    !response.ok ||
    data.ok === false
  ) {
    throw new Error(
      typeof data.error ===
      "string"
        ? data.error
        : `Comparison failed (${response.status}).`,
    );
  }

  if (
    !data.summary ||
    !Array.isArray(
      data.findings,
    )
  ) {
    throw new Error(
      "The server returned an invalid comparison result.",
    );
  }

  return {
    findings:
      data.findings as CompareFinding[],

    summary:
      data.summary as CompareResponse["summary"],
  };
}

/* =========================================================
   DOCUMENT EXTRACTION
========================================================= */

export type ExtractedPage = {
  pageNumber: number;
  text: string;
  method: "text" | "ocr";
};

export type ExtractedDocument = {
  id: string;
  name: string;
  type: string;
  size: number;
  pages: number;
  extractionMethod: "text" | "ocr" | "mixed";
  text: string;
  pageData: ExtractedPage[];
  warnings: string[];
};

export type ExtractDocumentResponse = {
  ok: boolean;
  document: ExtractedDocument;
};

export async function extractDocument(
  file: File,
): Promise<ExtractedDocument> {
  const formData =
    new FormData();

  formData.append(
    "file",
    file,
  );

  const response =
    await fetch(
      `${API_BASE_URL}/api/legal/extract`,
      {
        method: "POST",
        body: formData,
      },
    );

  let data:
    | ExtractDocumentResponse
    | {
        ok?: false;
        error?: string;
      };

  try {
    data =
      await response.json();
  } catch {
    throw new Error(
      "The document extraction server returned an invalid response.",
    );
  }

  if (
    !response.ok ||
    !data.ok
  ) {
    throw new Error(
      "error" in data &&
      data.error
        ? data.error
        : "Document extraction failed.",
    );
  }

  if (
    !data.document?.text?.trim()
  ) {
    throw new Error(
      "No readable text was extracted from the document.",
    );
  }

  return data.document;
}

