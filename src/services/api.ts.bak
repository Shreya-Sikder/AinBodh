import type { RecentDocument } from "../context/AppContext";

/* =========================================================
   ANALYSIS TYPES
========================================================= */

export type AnalysisResponse = {
  document: RecentDocument;
  overview: string;

  keyPoints: Array<{
    icon: string;
    label: string;
    value: string;
    citation?: string;
  }>;

  attention: Array<{
    level: "high" | "review" | "info";
    title: string;
    body: string;
    citation?: string;
  }>;

  contradictions: Array<{
    title: string;
    body: string;
    citations: string[];
  }>;

  missing: Array<{
    title: string;
    body: string;
  }>;

  terms: Array<{
    term: string;
    simple: string;
    inDocument: string;
    citation: string;
  }>;
};

/* =========================================================
   LEGAL CITATIONS
========================================================= */

export type LegalCitation = {
  id: string;
  title: string;
  actFile: string;
  sectionNumber: string | null;
  content: string;
  sourceName?: string;
  sourceUrl?: string;
};

/* =========================================================
   CHAT
========================================================= */

export type ChatMessage = {
  role: "user" | "assistant";
  content: string;
};

export type ChatResponse = {
  answer: string;
  citations: LegalCitation[];
  grounded?: boolean;
};

/* =========================================================
   COMPARE
========================================================= */

export type CompareDocumentInput = {
  name: string;
  text: string;
};

export type CompareFinding = {
  topic: string;

  status:
    | "consistent"
    | "different"
    | "potential_conflict"
    | "not_found";

  documents: Array<{
    documentName: string;
    excerpt: string;
  }>;

  explanation: string;
};

export type CompareResponse = {
  findings: CompareFinding[];

  summary: {
    documentsCompared: number;
    consistent: number;
    different: number;
    potentialConflicts: number;
    notFound: number;
  };
};

/* =========================================================
   API
========================================================= */

const API_BASE_URL =
  "http://127.0.0.1:5000";

const USER_STORAGE_KEY =
  "AinBodh-user";

const sleep = (ms: number) =>
  new Promise((resolve) =>
    window.setTimeout(
      resolve,
      ms,
    ),
  );

/* =========================================================
   AUTHENTICATION
   ---------------------------------------------------------
   Frontend prototype authentication.

   Account information is stored locally in the browser.
   This allows the login flow to work without internet.

   This is NOT production-grade authentication.
========================================================= */

type StoredUser = {
  name: string;
  email: string;
};

function saveUser(
  user: StoredUser,
) {
  localStorage.setItem(
    USER_STORAGE_KEY,
    JSON.stringify(user),
  );
}

function loadUser(): StoredUser | null {
  try {
    const saved =
      localStorage.getItem(
        USER_STORAGE_KEY,
      );

    if (!saved) {
      return null;
    }

    const parsed =
      JSON.parse(saved);

    if (
      !parsed ||
      typeof parsed !== "object" ||
      typeof parsed.name !== "string" ||
      typeof parsed.email !== "string"
    ) {
      return null;
    }

    const name =
      parsed.name.trim();

    const email =
      parsed.email.trim();

    if (!name || !email) {
      return null;
    }

    return {
      name,
      email,
    };
  } catch {
    localStorage.removeItem(
      USER_STORAGE_KEY,
    );

    return null;
  }
}

/* =========================================================
   SIGN UP
========================================================= */

export async function signup(
  name: string,
  email: string,
  password: string,
) {
  await sleep(450);

  const cleanName =
    name.trim();

  const cleanEmail =
    email.trim().toLowerCase();

  if (
    !cleanName ||
    !cleanEmail ||
    !password
  ) {
    throw new Error(
      "All fields are required.",
    );
  }

  if (password.length < 6) {
    throw new Error(
      "Password must be at least 6 characters.",
    );
  }

  /*
   * Current prototype authentication is local.
   *
   * We intentionally do NOT store the password.
   * The account identity is enough for the current
   * prototype login flow.
   */
  const user: StoredUser = {
    name: cleanName,
    email: cleanEmail,
  };

  saveUser(user);

  return {
    ok: true,

    offline: true,

    user: {
      name: user.name,
      email: user.email,
    },
  };
}

/* =========================================================
   LOGIN
========================================================= */

export async function login(
  email: string,
  password: string,
) {
  await sleep(250);

  const cleanEmail =
    email.trim().toLowerCase();

  if (
    !cleanEmail ||
    !password
  ) {
    throw new Error(
      "Email and password are required.",
    );
  }

  /* =======================================================
     OFFLINE DEMO ACCOUNT
     -------------------------------------------------------
     This account works on a fresh browser/computer
     without internet and without prior signup.
  ======================================================= */

  if (
    cleanEmail ===
      "demo@ainbodh.local" &&
    password === "demo1234"
  ) {
    const demoUser: StoredUser = {
      name: "AinBodh Demo User",
      email: "demo@ainbodh.local",
    };

    saveUser(demoUser);

    return {
      ok: true,

      offline: true,

      user: {
        name: demoUser.name,
        email: demoUser.email,
      },
    };
  }

  /* =======================================================
     NORMAL LOCAL ACCOUNT
     -------------------------------------------------------
     Accounts created through signup are stored locally,
     so they continue working without internet.
  ======================================================= */

  const savedUser =
    loadUser();

  if (!savedUser) {
    throw new Error(
      "No account was found. Please sign up first, or use the Offline Demo account.",
    );
  }

  if (
    savedUser.email.toLowerCase() !==
    cleanEmail
  ) {
    throw new Error(
      "No account was found for this email. Please sign up first, or use the Offline Demo account.",
    );
  }

  /*
   * Passwords are intentionally not persisted in this
   * prototype, so the password is currently validated
   * only for presence.
   *
   * Real authentication should use a secure backend
   * or authentication provider before production.
   */

  return {
    ok: true,

    offline: true,

    user: {
      name: savedUser.name,
      email: savedUser.email,
    },
  };
}

/* =========================================================
   UPLOAD DOCUMENT
========================================================= */

export async function uploadDocument(
  file: File,
) {
  await sleep(300);

  return {
    id: `doc-${Date.now()}`,
    name: file.name,

    /*
     * NOTE:
     * Page count is still a temporary fallback.
     * Real PDF/page extraction should replace this.
     */
    pages: 8,

    type: file.type.includes("pdf")
      ? "PDF document"
      : "Uploaded document",

    size: file.size,

    status:
      "Processing" as const,

    uploadedAt:
      Date.now(),
  };
}

