# Frontend settings (copy to .env in the project root). These are public — never put secrets here.

# AinBodh backend URL
VITE_API_BASE_URL=http://127.0.0.1:5000

# Real accounts (Supabase Auth). Use the project's *anon* public key, NOT the service-role key.
# Leave empty for the local development login (any email/password).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
